#!/usr/bin/env python3
import atexit
import os
import re
import subprocess
import sys
import time

LAYER_PRELOAD = "/usr/lib/libgtk4-layer-shell.so.0"
if (
    os.path.exists(LAYER_PRELOAD)
    and "libgtk4-layer-shell" not in os.environ.get("LD_PRELOAD", "")
    and os.environ.get("SSH_ASKPASS_GUI_REEXEC") != "1"
):
    os.environ["LD_PRELOAD"] = LAYER_PRELOAD + (
        ":" + os.environ["LD_PRELOAD"] if os.environ.get("LD_PRELOAD") else ""
    )
    os.environ["SSH_ASKPASS_GUI_REEXEC"] = "1"
    os.execv(sys.executable, [sys.executable] + sys.argv)

try:
    import gi

    gi.require_version("Gtk", "4.0")
    from gi.repository import Gdk, Gio, GLib, Gtk
except Exception:
    sys.exit(2)

try:
    gi.require_version("Gtk4LayerShell", "1.0")
    from gi.repository import Gtk4LayerShell as LayerShell
except Exception:
    LayerShell = None

APP_ID = "dev.arsolitt.SshAskpass"
RETRY_DELAY = 0.6
FAST_FAILURE = 0.4


def lookup_secret(name):
    if not name:
        return ""
    try:
        out = subprocess.run(
            ["secret-tool", "lookup", "service", "ssh", "key", name],
            capture_output=True,
            text=True,
            timeout=5,
        )
    except Exception:
        return ""
    return out.stdout if out.returncode == 0 else ""


class Askpass(Gtk.Application):
    def __init__(self, prompt):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.NON_UNIQUE)
        match = re.search(r"/[^ ':]+", prompt)
        self.key_name = os.path.basename(match.group(0)) if match else ""
        self.secret = lookup_secret(self.key_name)
        self.proc = None
        self.done = False
        self.result = None
        self.win = None
        self.status = None
        self.started_at = 0.0
        self.retry_at = 0.0
        self.fast_failures = 0
        atexit.register(self.stop_proc)

    def do_activate(self):
        self.win = Gtk.ApplicationWindow(application=self, title="SSH passphrase")
        self.win.set_default_size(440, -1)
        self.win.set_resizable(False)
        self.win.connect("close-request", self.on_close)
        self.win.add_css_class("ssh-askpass")
        provider = Gtk.CssProvider()
        provider.load_from_data(
            b"window.ssh-askpass { border: 1px solid rgba(255, 255, 255, 0.28); border-radius: 12px; }"
        )
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )
        if LayerShell is not None:
            LayerShell.init_for_window(self.win)
            LayerShell.set_namespace(self.win, "ssh-askpass")
            LayerShell.set_layer(self.win, LayerShell.Layer.OVERLAY)
            LayerShell.set_keyboard_mode(self.win, LayerShell.KeyboardMode.EXCLUSIVE)

        box = Gtk.Box(
            orientation=Gtk.Orientation.VERTICAL,
            spacing=12,
            margin_top=18,
            margin_bottom=18,
            margin_start=18,
            margin_end=18,
        )
        self.win.set_child(box)

        title = Gtk.Label(
            label=f"Unlock {self.key_name}" if self.key_name else "SSH passphrase",
            xalign=0,
        )
        title.add_css_class("title-3")
        box.append(title)

        hint = Gtk.Label(
            label="Touch the fingerprint sensor or type the passphrase.",
            xalign=0,
            wrap=True,
        )
        box.append(hint)

        self.entry = Gtk.PasswordEntry(show_peek_icon=True, placeholder_text="Passphrase")
        self.entry.connect("activate", self.on_submit)
        box.append(self.entry)

        self.status = Gtk.Label(label="Fingerprint: waiting for a touch", xalign=0, wrap=True)
        self.status.add_css_class("dim-label")
        box.append(self.status)

        buttons = Gtk.Box(spacing=6, halign=Gtk.Align.END)
        cancel = Gtk.Button(label="Cancel")
        cancel.connect("clicked", lambda *_: self.finish(None))
        unlock = Gtk.Button(label="Unlock")
        unlock.add_css_class("suggested-action")
        unlock.connect("clicked", self.on_submit)
        buttons.append(cancel)
        buttons.append(unlock)
        box.append(buttons)

        self.win.present()
        self.entry.grab_focus()
        GLib.timeout_add(200, self.tick)

    def on_close(self, *_):
        self.finish(None)
        return True

    def on_submit(self, *_):
        text = self.entry.get_text()
        if not text:
            self.status.set_text("Type the passphrase or touch the sensor.")
            return
        self.finish(text)

    def resolve_secret(self):
        if not self.secret:
            self.secret = lookup_secret(self.key_name)
        return self.secret

    def stop_proc(self):
        if self.proc is None:
            return
        self.proc.terminate()
        try:
            self.proc.wait(timeout=2)
        except Exception:
            self.proc.kill()
        self.proc = None

    def start_verify(self):
        if not self.key_name or not os.path.exists("/usr/bin/fprintd-verify"):
            self.status.set_text("Fingerprint: unavailable")
            self.retry_at = float("inf")
            return
        self.stop_proc()
        try:
            self.proc = subprocess.Popen(
                ["fprintd-verify", "-f", "any"],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.PIPE,
            )
        except Exception:
            self.status.set_text("Fingerprint: unavailable")
            self.retry_at = float("inf")
            return
        self.started_at = time.monotonic()

    def tick(self):
        if self.done:
            return False
        now = time.monotonic()

        if self.proc is None:
            if now >= self.retry_at:
                self.start_verify()
            return True

        code = self.proc.poll()
        if code is None:
            return True

        stderr = b""
        try:
            stderr = self.proc.stderr.read() or b""
        except Exception:
            pass
        elapsed = now - self.started_at
        self.proc = None

        if code == 0:
            secret = self.resolve_secret()
            if secret:
                self.finish(secret)
            else:
                self.status.set_text("Fingerprint matched, but no keyring entry for this key.")
            return False

        message = stderr.decode(errors="replace")
        if "already claimed" in message:
            self.fast_failures += 1
            if self.fast_failures >= 3:
                self.status.set_text("Fingerprint sensor is busy, type the passphrase.")
                self.retry_at = float("inf")
                return True
            self.status.set_text("Fingerprint sensor is busy, retrying")
        elif elapsed < FAST_FAILURE:
            self.fast_failures += 1
            if self.fast_failures >= 3:
                self.status.set_text("Fingerprint unavailable, type the passphrase.")
                self.retry_at = float("inf")
                return True
        else:
            self.fast_failures = 0
            self.status.set_text("Fingerprint not recognised, touch again or type the passphrase.")

        self.retry_at = now + RETRY_DELAY
        return True

    def finish(self, value):
        if self.done:
            return
        self.done = True
        self.stop_proc()
        self.result = value
        self.quit()


def main():
    prompt = sys.argv[1] if len(sys.argv) > 1 else ""
    app = Askpass(prompt)
    app.run([])
    if app.result:
        sys.stdout.write(app.result if app.result.endswith("\n") else app.result + "\n")
        return 0
    return 1


if __name__ == "__main__":
    sys.exit(main())
