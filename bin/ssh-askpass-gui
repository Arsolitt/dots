#!/usr/bin/env python3
import os
import re
import subprocess
import sys

try:
    import gi

    gi.require_version("Gtk", "4.0")
    from gi.repository import Gio, GLib, Gtk
except Exception:
    sys.exit(2)

APP_ID = "dev.arsolitt.SshAskpass"


def lookup_secret(name):
    if not name:
        return ""
    try:
        out = subprocess.run(
            ["secret-tool", "lookup", "service", "ssh", "key", name],
            capture_output=True,
            text=True,
            timeout=5,
        )
    except Exception:
        return ""
    return out.stdout if out.returncode == 0 else ""


class Askpass(Gtk.Application):
    def __init__(self, prompt):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.NON_UNIQUE)
        match = re.search(r"/[^ ':]+", prompt)
        self.key_name = os.path.basename(match.group(0)) if match else ""
        self.secret = lookup_secret(self.key_name)
        self.proc = None
        self.done = False
        self.result = None
        self.win = None

    def do_activate(self):
        self.win = Gtk.ApplicationWindow(application=self, title="SSH passphrase")
        self.win.set_default_size(440, -1)
        self.win.set_resizable(False)

        box = Gtk.Box(
            orientation=Gtk.Orientation.VERTICAL,
            spacing=12,
            margin_top=18,
            margin_bottom=18,
            margin_start=18,
            margin_end=18,
        )
        self.win.set_child(box)

        title = Gtk.Label(
            label=f"Unlock {self.key_name}" if self.key_name else "SSH passphrase",
            xalign=0,
        )
        title.add_css_class("title-3")
        box.append(title)

        hint = Gtk.Label(
            label="Touch the fingerprint sensor or type the passphrase.",
            xalign=0,
            wrap=True,
        )
        box.append(hint)

        self.entry = Gtk.PasswordEntry(show_peek_icon=True, placeholder_text="Passphrase")
        self.entry.connect("activate", self.on_submit)
        box.append(self.entry)

        self.status = Gtk.Label(label="Fingerprint: waiting for a touch", xalign=0, wrap=True)
        self.status.add_css_class("dim-label")
        box.append(self.status)

        buttons = Gtk.Box(spacing=6, halign=Gtk.Align.END)
        cancel = Gtk.Button(label="Cancel")
        cancel.connect("clicked", lambda *_: self.finish(None))
        unlock = Gtk.Button(label="Unlock")
        unlock.add_css_class("suggested-action")
        unlock.connect("clicked", self.on_submit)
        buttons.append(cancel)
        buttons.append(unlock)
        box.append(buttons)

        self.win.present()
        self.entry.grab_focus()
        self.start_verify()
        GLib.timeout_add(300, self.poll_verify)

    def on_submit(self, *_):
        text = self.entry.get_text()
        if not text:
            self.status.set_text("Type the passphrase or touch the sensor.")
            return
        self.finish(text)

    def resolve_secret(self):
        if not self.secret:
            self.secret = lookup_secret(self.key_name)
        return self.secret

    def start_verify(self):
        if self.key_name and os.path.exists("/usr/bin/fprintd-verify"):
            try:
                self.proc = subprocess.Popen(
                    ["fprintd-verify"],
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                )
                return
            except Exception:
                pass
        self.status.set_text("Fingerprint: unavailable")

    def poll_verify(self):
        if self.done or self.proc is None:
            return False
        code = self.proc.poll()
        if code is None:
            return True
        self.proc = None
        if code == 0:
            secret = self.resolve_secret()
            if secret:
                self.finish(secret)
            else:
                self.status.set_text("Fingerprint matched, but no keyring entry for this key.")
        else:
            self.status.set_text("Fingerprint not recognised, type the passphrase.")
        return False

    def finish(self, value):
        if self.done:
            return
        self.done = True
        if self.proc is not None:
            self.proc.terminate()
            try:
                self.proc.wait(timeout=2)
            except Exception:
                self.proc.kill()
            self.proc = None
        self.result = value
        self.quit()


def main():
    prompt = sys.argv[1] if len(sys.argv) > 1 else ""
    app = Askpass(prompt)
    app.run([])
    if app.result:
        sys.stdout.write(app.result if app.result.endswith("\n") else app.result + "\n")
        return 0
    return 1


if __name__ == "__main__":
    sys.exit(main())
