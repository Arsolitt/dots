[Unit]
Description=DeepFilterNet microphone denoiser on the Intel NPU
After=pipewire.service wireplumber.service

[Service]
Type=simple
WorkingDirectory=%h/projects/npu-denoise
Environment=PYTHONUNBUFFERED=1
ExecStartPre=%h/projects/npu-denoise/scripts/virtual-source.sh start
ExecStart=/usr/bin/uv run --quiet realtime.py --device NPU --source alsa_input.pci-0000_00_1f.3-platform-skl_hda_dsp_generic.HiFi__Mic1__source --sink npu_denoise
ExecStopPost=-%h/projects/npu-denoise/scripts/virtual-source.sh stop
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
