# git-abbrs.zsh — static git abbreviations (zsh-abbr).
# Ported from fish/functions/__git.init.fish lines 19-195.
# Dynamic entries (those using __git.current_branch / __git.default_branch)
# are implemented as functions in functions.zsh, not here — zsh-abbr
# expansions are static strings and cannot resolve branch names at runtime.

